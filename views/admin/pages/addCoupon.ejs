


<div class="container">
    <div class="row justify-content-center">
        <%- include('../partials/flash.ejs') %>
       
        <div class="col-lg-8 d-flex align-items-stretch">
            <div class="card w-100">
                <div class="card-body p-4">
                    <h1 class="mt-5">Create a New Coupon</h1>
                    <form id="couponForm" action="/admin/coupon/add" method="post">
                        <div class="input-group mb-3">
                            <label for="code" class="input-group-text">Coupon Code:</label>
                            <input
                                type="text"
                                class="form-control"
                                id="code"
                                name="code"
                                value="<%= data?.code %>"
                                readonly
                            />
                        </div>
                        <div class="form-group">
                            <label for="type">Coupon Type:</label>
                            <select class="form-control" id="type" name="type">
                                <option value="" disabled selected>Select Type</option>
                                <option value="percentage">Percentage</option>
                                <option value="fixedAmount">Fixed Amount</option>
                            </select>
                            <small id="typeError" class="text-danger"></small>
                        </div>

                        <div class="form-group">
                            <label for="value">Discount Value:</label>
                            <input type="number" class="form-control" id="value" name="value" />
                            <small id="valueError" class="text-danger"></small>
                        </div>

                        <div class="form-group">
                            <label for="value">Discription:</label>
                            <textarea
                                class="form-control"
                                id="description"
                                rows="3"
                                name="description"
                                placeholder="Enter product description"
                            ></textarea>
                            <small id="descriptionError" class="text-danger"></small>
                        </div>

                        <div class="form-group">
                            <label for="expiryDate">Expiry Date:</label>
                            <input
                                type="date"
                                class="form-control"
                                id="expiryDate"
                                name="expiryDate"
                                value="<%= data?.expiryDate %>"
                            />
                            <small id="expiryDateError" class="text-danger"></small>
                        </div>

                        <div class="form-group">
                            <label for="minAmount">Minimum Purchase Amount:</label>
                            <input
                                type="number"
                                class="form-control"
                                id="minAmount"
                                name="minAmount"
                                value="<%= data?.minAmount %>"
                            />
                            <small id="minAmountError" class="text-danger"></small>
                        </div>

                        <div class="form-group">
                            <label for="maxAmount">Maximum Discount Amount:</label>
                            <input
                                type="number"
                                class="form-control"
                                id="maxAmount"
                                name="maxAmount"
                                value="<%= data?.maxAmount %>"
                            />
                            <small id="maxAmountError" class="text-danger"></small>
                        </div>

                        <button type="submit" class="btn btn-primary" id="submitButton">Create Coupon</button>
                        <small id="formError" class="text-danger"></small>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const submitForm = document.getElementById("submitForm");

        const typeInput = document.getElementById("type");
        const valueInput = document.getElementById("value");
        const expiryDateInput = document.getElementById("expiryDate");
        const minAmountInput = document.getElementById("minAmount");
        const maxAmountInput = document.getElementById("maxAmount");
        const descriptionInput = document.getElementById("description");
        const codeInput = document.getElementById("code");

        const typeError = document.getElementById("typeError");
        const valueError = document.getElementById("valueError");
        const expiryDateError = document.getElementById("expiryDateError");
        const minAmountError = document.getElementById("minAmountError");
        const maxAmountError = document.getElementById("maxAmountError");
        const descriptionError = document.getElementById("descriptionError");
        const formError = document.getElementById("formError");

        let isValid = true;

        function generateCouponCode() {
            const characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
            let code = "";
            for (let i = 0; i < 8; i++) {
                code += characters.charAt(Math.floor(Math.random() * characters.length));
            }
            codeInput.value = code;

            const selectedType = typeInput.value;
            if (selectedType === "percentage") {
                maxAmountInput.disabled = false;
            } else {
                maxAmountInput.disabled = true;
                maxAmountInput.value = "";
                maxAmountError.textContent = "";
            }
        }

        function validateType() {
            const type = typeInput.value.trim();
            if (!type) {
                typeError.textContent = "Coupon Type is required";
                isValid = false;
            } else {
                typeError.textContent = "";
            }
        }

        function validateValue() {
            const value = valueInput.value.trim();
            if (!value || parseFloat(value) <= 0) {
                valueError.textContent = "Coupon Value is required and must be greater than 0";
                isValid = false;
            } else {
                valueError.textContent = "";
            }
        }

        function validateExpiryDate() {
            const expiry = expiryDateInput.value;
            if (!expiry) {
                expiryDateError.textContent = "Expiry Date is required";
                isValid = false;
            } else {
                expiryDateError.textContent = "";
            }
        }

        function validateMinAmount() {
            const minAmount = minAmountInput.value.trim();
            if (!minAmount || parseFloat(minAmount) <= 0) {
                minAmountError.textContent = "Minimum Purchase Amount is required and must be greater than 0";
                isValid = false;
            } else {
                minAmountError.textContent = "";
            }
        }

        function validateMaxAmount() {
            const type = typeInput.value;
            const maxAmount = maxAmountInput.value.trim();

            if (type === "percentage") {
                if (!maxAmount || parseFloat(maxAmount) <= 0) {
                    maxAmountError.textContent = "Maximum Discount Amount is required for percentage type and must be greater than 0";
                    isValid = false;
                } else {
                    maxAmountError.textContent = "";
                }
            } else {
                maxAmountError.textContent = "";
            }
        }

        function validateDescription() {
            const description = descriptionInput.value.trim();
            if (!description) {
                descriptionError.textContent = "Coupon Description is required";
                isValid = false;
            } else {
                descriptionError.textContent = "";
            }
        }

        // Regenerate coupon code and validate maxAmount on type change
        typeInput.addEventListener("change", () => {
            generateCouponCode();
            validateMaxAmount();
        });

        // Final form submit
        submitForm.addEventListener("submit", (e) => {
            e.preventDefault();
            isValid = true;

            validateType();
            validateValue();
            validateExpiryDate();
            validateMinAmount();
            validateMaxAmount();
            validateDescription();

            if (isValid) {
                formError.textContent = "";
                submitForm.submit();
            } else {
                formError.textContent = "Please fix the errors above before submitting.";
            }
        });
    });
</script>
